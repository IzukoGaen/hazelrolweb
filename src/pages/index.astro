---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const profile = await getEntry("profile", "profile");
const theme = await getEntry("theme", "theme");

if (!profile || !theme) {
  throw new Error("Missing src/content/settings/profile.json or theme.json");
}

const { data: p } = profile;
---

<BaseLayout
  title={p.seo.title}
  description={p.seo.description}
  lang={p.language}
  accent={theme.data.accent}
>
  <main class="container">
    <h1>{p.name}</h1>
  </main>
</BaseLayout>

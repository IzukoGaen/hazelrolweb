---
import { Image } from "astro:assets";
import { emphasis } from "../lib/emphasis";
import type { SectionProps } from "../lib/sections";

type Props = SectionProps;

const { profile, projects } = Astro.props;
const { work } = profile;
---

<section class="work" id="work" aria-labelledby="work-title">
  <div class="container frame">
    <div class="grid-row section-head">
      <h2 class="cell section-title" id="work-title" set:html={emphasis(work.heading)} />
      <p class="cell small">{work.intro}</p>
    </div>

    <div class="work-grid">
      {projects.map(({ data }) => (
        <article class="card reveal">
          <div class="cover">
            {data.cover ? (
              <Image
                src={data.cover}
                alt={data.coverAlt ?? ""}
                widths={[480, 720, 1080]}
                sizes="(min-width: 720px) 50vw, 100vw"
              />
            ) : (
              <div class="cover-placeholder" aria-hidden="true">
                <span>{data.category}</span>
              </div>
            )}
          </div>
          <div class="card-info">
            <h3>{data.title}</h3>
            <p class="label">{data.category} · {data.year}</p>
            <p class="summary">{data.summary}</p>
            {data.resultValue && (
              <p class="result">
                <strong>{data.resultValue}</strong> {data.resultLabel}
              </p>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section-head {
    align-items: end;
  }

  .section-head .section-title {
    padding-top: clamp(var(--space-6), 8vw, var(--space-12));
  }

  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  .card {
    display: flex;
    flex-direction: column;
    border-bottom: var(--border-thin) solid var(--line);
  }

  .card:last-child {
    border-bottom: 0;
  }

  .cover {
    margin: clamp(var(--space-2), 2vw, var(--space-3));
    margin-bottom: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: var(--border-thick) solid var(--outline);
    transition:
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .card:hover .cover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-hard-lg);
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover-placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    background: radial-gradient(circle at 70% 25%, var(--surface) 0%, var(--accent-soft) 40%, var(--accent) 100%);
    color: var(--ink);
  }

  .cover-placeholder span {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: 1;
  }

  .card-info {
    display: grid;
    gap: var(--space-1);
    padding: clamp(var(--space-2), 2vw, var(--space-3));
  }

  .card-info h3 {
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .summary {
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .result {
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .result strong {
    color: var(--accent-text);
    font-weight: 600;
  }

  @media (min-width: 720px) {
    .section-head {
      grid-template-columns: 2fr 1fr;
    }

    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .card:nth-child(odd) {
      border-right: var(--border-thin) solid var(--line);
    }

    .card:nth-last-child(2):nth-child(odd) {
      border-bottom: 0;
    }
  }
</style>

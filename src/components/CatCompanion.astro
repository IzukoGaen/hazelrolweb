          <path class="ear-in" d="M52.5 17L52 10L47 13.5Z" />
          <ellipse class="fur" cx="40" cy="28" rx="19" ry="16.5" />
          <path class="stripe" d="M36 13.5L36.8 18M40 12.5V17.5M44 13.5L43.2 18" />
          <ellipse class="cream" cx="40" cy="35.5" rx="7.5" ry="4.8" />
          <ellipse class="blush" cx="29" cy="33.5" rx="3.2" ry="1.9" />
          <ellipse class="blush" cx="51" cy="33.5" rx="3.2" ry="1.9" />
          <ellipse class="eye" cx="33" cy="28" rx="3" ry="3.6" />
          <ellipse class="eye" cx="47" cy="28" rx="3" ry="3.6" />
          <circle class="shine" cx="34" cy="26.6" r="1.1" />
          <circle class="shine" cx="48" cy="26.6" r="1.1" />
          <path class="nose" d="M38.5 32.6H41.5L40 34.3Z" />
          <path class="line" d="M40 34.3Q38.8 36.2 37.2 35.3M40 34.3Q41.2 36.2 42.8 35.3" />
        </g>
      </g>

      <g class="pose pose-walk">
        <g class="tail">
          <path class="tail-o" d="M23 44C13 43 9 34 12 25C13 21 17 20 18 23" />
          <path class="tail-f" d="M23 44C13 43 9 34 12 25C13 21 17 20 18 23" />
          <path class="tail-s" d="M23 44C13 43 9 34 12 25C13 21 17 20 18 23" />
        </g>
        <g class="leg leg-a"><rect class="fur" x="24" y="47" width="6" height="13" rx="3" /><ellipse class="cream-o" cx="27" cy="60" rx="3.4" ry="2.2" /></g>
        <g class="leg leg-b"><rect class="fur" x="44" y="47" width="6" height="13" rx="3" /><ellipse class="cream-o" cx="47" cy="60" rx="3.4" ry="2.2" /></g>
        <ellipse class="fur" cx="38" cy="46" rx="17" ry="10" />
        <ellipse class="cream" cx="40" cy="51" rx="10" ry="3.6" />
        <path class="stripe" d="M30 37.5L31 41.5M36 36.5L36.5 40.5" />
        <g class="leg leg-b"><rect class="fur" x="30" y="48" width="6" height="13" rx="3" /><ellipse class="cream-o" cx="33" cy="61" rx="3.4" ry="2.2" /></g>
        <g class="leg leg-a"><rect class="fur" x="50" y="48" width="6" height="13" rx="3" /><ellipse class="cream-o" cx="53" cy="61" rx="3.4" ry="2.2" /></g>
        <g class="head">
          <path class="fur" d="M43 23L45 8.5L54 15.5Z" />
          <path class="fur" d="M70 23L67.5 8.5L59 15Z" />
          <path class="ear-in" d="M46.5 19L47.2 12L51.5 15.5Z" />
          <path class="ear-in" d="M66.5 19L65.6 12L61.5 15.3Z" />
          <ellipse class="fur" cx="57" cy="29" rx="16" ry="14.5" />
          <path class="stripe" d="M53.5 15.5L54.2 20M57.5 14.7V19.7M61.5 15.5L60.8 20" />
          <ellipse class="cream" cx="61" cy="35.5" rx="7" ry="4.5" />
          <ellipse class="blush" cx="50" cy="34" rx="2.6" ry="1.6" />
          <ellipse class="blush" cx="70" cy="34" rx="2.4" ry="1.6" />
          <ellipse class="eye" cx="54.5" cy="28.5" rx="2.8" ry="3.4" />
          <ellipse class="eye" cx="65" cy="28.5" rx="2.6" ry="3.4" />
          <circle class="shine" cx="55.4" cy="27.2" r="1" />
          <circle class="shine" cx="65.8" cy="27.2" r="1" />
          <path class="nose" d="M59.8 32.7H62.6L61.2 34.3Z" />
          <path class="line" d="M61.2 34.3Q60.1 36 58.6 35.2M61.2 34.3Q62.3 36 63.8 35.2" />
        </g>
      </g>

      <g class="pose pose-sleep">
        <g class="breath">
          <ellipse class="fur" cx="38" cy="51" rx="22" ry="11" />
          <path class="stripe" d="M28 41.5L29 45.5M34 40.5L34.5 44.5M40 40.5V44.5" />
          <g class="sleep-head">
            <path class="fur" d="M42 42L42.5 30.5L50 36Z" />
            <path class="fur" d="M64 41L64.5 29.5L56.5 35Z" />
            <path class="ear-in" d="M44.5 39L44.8 33.5L48.2 36Z" />
            <path class="ear-in" d="M61.6 38.5L62 33L58.3 35.4Z" />
            <ellipse class="fur" cx="53" cy="47" rx="14" ry="11.5" />
            <path class="stripe" d="M50 36.5L50.6 40M53 36V39.6M56 36.5L55.4 40" />
            <ellipse class="cream" cx="53.5" cy="52" rx="6" ry="3.8" />
            <ellipse class="blush" cx="45" cy="50.5" rx="2.6" ry="1.6" />
            <ellipse class="blush" cx="62" cy="50.5" rx="2.6" ry="1.6" />
            <path class="line" d="M45.5 46.5Q48 48.8 50.5 46.5M56 46.5Q58.5 48.8 61 46.5" />
            <path class="nose" d="M52.3 49.6H54.9L53.6 51Z" />
          </g>
        </g>
        <g class="tail">
          <path class="tail-o" d="M17 53C14 62 34 64 50 61.5" />
          <path class="tail-f" d="M17 53C14 62 34 64 50 61.5" />
          <path class="tail-s" d="M17 53C14 62 34 64 50 61.5" />
        </g>
        <g transform="translate(66 30)"><path class="z z1" d="M0 0H5L0 6H5" /></g>
        <g transform="translate(71 21)"><path class="z z2" d="M0 0H4L0 5H4" /></g>
        <g transform="translate(75 13)"><path class="z z3" d="M0 0H3.5L0 4.2H3.5" /></g>
      </g>
    </svg>
  </div>
</div>

<script>
  import { SKY_DIAL_EVENT, isNight, type SkyDialChange } from "../lib/skyTime";

  type CatPose = "sit" | "walk" | "sleep";

  const ENTRANCE_MS = 2600;
  const MAX_FRAME_MS = 50;

  const cat = document.querySelector<HTMLElement>("[data-cat]");

  if (cat) {
    const root = document.documentElement;
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const preset = root.dataset.skyMinutes;
    const now = new Date();
    let night = isNight(preset !== undefined ? Number(preset) : now.getHours() * 60 + now.getMinutes());
    let walking = false;

    const setPose = (pose: CatPose) => {
      cat.dataset.pose = pose;
    };
    const rest = () => setPose(night ? "sleep" : "sit");

    window.addEventListener(SKY_DIAL_EVENT, (event) => {
      night = isNight((event as CustomEvent<SkyDialChange>).detail.minutes);
      if (!walking) rest();
    });

    document.addEventListener("visibilitychange", () => {
      cat.toggleAttribute("data-paused", document.hidden);
    });

    // Daytime entrance: trots in from the left edge, then sits. Elapsed time is
    // clamped per frame, so a hidden tab pauses the walk instead of skipping it.
    if (!reduceMotion && !night) {
      walking = true;
      setPose("walk");
      const from = -(cat.getBoundingClientRect().right + 16);
      let elapsed = 0;
      let last = performance.now();
      const step = (time: number) => {
        elapsed += Math.min(time - last, MAX_FRAME_MS);
        last = time;
        const t = Math.min(1, elapsed / ENTRANCE_MS);
        const eased = 1 - (1 - t) * (1 - t);
        cat.style.transform = `translateX(${(from * (1 - eased)).toFixed(1)}px)`;
        if (t < 1) {
          requestAnimationFrame(step);
          return;
        }
        walking = false;
        rest();
      };
      cat.style.transform = `translateX(${from}px)`;
      requestAnimationFrame(step);
    } else {
      rest();
    }

    requestAnimationFrame(() => cat.setAttribute("data-ready", ""));
  }
</script>

<style>
  .cat-layer {
    position: fixed;
    left: max(var(--space-3), env(safe-area-inset-left));
    bottom: env(safe-area-inset-bottom);
    z-index: 35;
    pointer-events: none;
  }

  .cat {
    height: var(--cat-size);
    aspect-ratio: 80 / 64;
    will-change: transform;
  }

  .cat svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .pose {
    opacity: 0;
  }

  .cat[data-ready] .pose {
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .cat[data-pose="sit"] .pose-sit,
  .cat[data-pose="walk"] .pose-walk,
  .cat[data-pose="sleep"] .pose-sleep {
    opacity: 1;
  }

  .fur {
    fill: var(--cat-fur);
    stroke: var(--cat-outline);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .cream {
    fill: var(--cat-cream);
  }

  .cream-o {
    fill: var(--cat-cream);
    stroke: var(--cat-outline);
    stroke-width: 1.3;
  }

  .stripe {
    fill: none;
    stroke: var(--cat-stripe);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .ear-in {
    fill: var(--cat-ear);
  }

  .eye {
    fill: var(--cat-eye);
  }

  .shine {
    fill: var(--cat-shine);
  }

  .nose {
    fill: var(--cat-nose);
  }

  .blush {
    fill: var(--cat-blush);
    opacity: 0.75;
  }

  .line {
    fill: none;
    stroke: var(--cat-outline);
    stroke-width: 1.2;
    stroke-linecap: round;
  }

  .tail-o,
  .tail-f,
  .tail-s {
    fill: none;
  }

  .tail-o {
    stroke: var(--cat-outline);
    stroke-width: 8.5;
    stroke-linecap: round;
  }

  .tail-f {
    stroke: var(--cat-fur);
    stroke-width: 5.5;
    stroke-linecap: round;
  }

  .tail-s {
    stroke: var(--cat-stripe);
    stroke-width: 5.5;
    stroke-dasharray: 2.5 6;
  }

  .tail,
  .leg,
  .breath,
  .z {
    transform-box: view-box;
  }

  .pose-sit .tail {
    transform-origin: 52px 57px;
  }

  .pose-walk .tail {
    transform-origin: 23px 44px;
  }

  .cat[data-pose="sit"] .pose-sit .tail {
    animation: tail-sway 2.8s ease-in-out infinite alternate;
  }

  .cat[data-pose="walk"] .pose-walk .tail {
    animation: tail-sway 0.9s ease-in-out infinite alternate;
  }

  @keyframes tail-sway {
    from {
      transform: rotate(-7deg);
    }
    to {
      transform: rotate(9deg);
    }
  }

  .leg {
    transform-box: fill-box;
    transform-origin: 50% 15%;
  }

  .cat[data-pose="walk"] .leg-a {
    animation: leg-swing 0.5s ease-in-out infinite alternate;
  }

  .cat[data-pose="walk"] .leg-b {
    animation: leg-swing 0.5s ease-in-out infinite alternate-reverse;
  }

  @keyframes leg-swing {
    from {
      transform: rotate(-20deg);
    }
    to {
      transform: rotate(20deg);
    }
  }

  .breath {
    transform-origin: 40px 62px;
  }

  .cat[data-pose="sleep"] .breath {
    animation: breathe 3.6s ease-in-out infinite alternate;
  }

  @keyframes breathe {
    to {
      transform: scale(1.015, 1.045);
    }
  }

  .z {
    fill: none;
    stroke: var(--cat-zzz);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.9;
  }

  .cat[data-pose="sleep"] .z {
    animation: z-rise 3s ease-out infinite;
  }

  .cat[data-pose="sleep"] .z2 {
    animation-delay: -1s;
  }

  .cat[data-pose="sleep"] .z3 {
    animation-delay: -2s;
  }

  @keyframes z-rise {
    0% {
      opacity: 0;
      transform: translate(0, 4px);
    }
    30% {
      opacity: 0.95;
    }
    100% {
      opacity: 0;
      transform: translate(5px, -8px);
    }
  }

  .cat[data-paused] * {
    animation-play-state: paused !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .cat * {
      animation: none !important;
    }
  }
</style>

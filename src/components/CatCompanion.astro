        </g>
        <ellipse class="fur" cx="40" cy="50" rx="15" ry="12.5" />
        <ellipse class="cream" cx="40" cy="53" rx="8" ry="8" />
        <ellipse class="cream-o" cx="34" cy="60.5" rx="4.5" ry="3" />
        <ellipse class="cream-o" cx="46" cy="60.5" rx="4.5" ry="3" />
        <g class="head">
          <path class="fur" d="M24 21L25.5 6.5L36.5 13.5Z" />

---
// Original chibi orange tabby. Three poses share one 80x64 canvas (ground at
// y=62); only the active pose is visible and animated.
---

<div class="cat-layer" aria-hidden="true">
  <div class="cat" data-cat data-pose="sit">
    <svg viewBox="0 0 80 64">

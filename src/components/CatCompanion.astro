---
import {
  CAT_FRAMES,
  CAT_ZZZ,
  PIXEL_CLASS,
  SPRITE_HEIGHT,
  SPRITE_WIDTH,
  toPaths,
  type CatFrame,
} from "../lib/catSprites";

const frames = (Object.keys(CAT_FRAMES) as CatFrame[]).map((name) => ({
  name,
  paths: toPaths(CAT_FRAMES[name]),
}));
---

<div class="cat-layer" aria-hidden="true">
  <div class="cat" data-cat data-pose="sit" data-facing="right">
    <svg viewBox={`0 0 ${SPRITE_WIDTH} ${SPRITE_HEIGHT}`} shape-rendering="crispEdges">
      {frames.map(({ name, paths }) => (
        <g class={`frame frame-${name}`}>
          {paths.map((p) => <path class={`px-${PIXEL_CLASS[p.key]}`} d={p.d} />)}
        </g>
      ))}
      <g class="zzz zzz-big">{CAT_ZZZ.big.map((p) => <path class={`px-${PIXEL_CLASS[p.key]}`} d={p.d} />)}</g>
      <g class="zzz zzz-small">{CAT_ZZZ.small.map((p) => <path class={`px-${PIXEL_CLASS[p.key]}`} d={p.d} />)}</g>
    </svg>
  </div>
</div>

<script>
  import { SKY_DIAL_EVENT, isNight, type SkyDialChange } from "../lib/skyTime";

  type CatState = "walk" | "sit" | "sleep";
  type Facing = 1 | -1;

  const SPEED_PX_PER_S = 34;
  const EDGE_GAP_PX = 16;
  const DIAL_GAP_PX = 12;
  const MAX_FRAME_MS = 50;
  const WALK_MS: [number, number] = [3500, 8000];
  const SIT_MS: [number, number] = [2500, 6000];

  const cat = document.querySelector<HTMLElement>("[data-cat]");

  if (cat) {
    const root = document.documentElement;
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const between = ([min, max]: [number, number]) => min + Math.random() * (max - min);

    let state: CatState = "sit";
    let facing: Facing = 1;
    let x = EDGE_GAP_PX;
    let timer = 0;
    let lookAt = -1;
    let bounds = { min: EDGE_GAP_PX, max: EDGE_GAP_PX };

    const preset = root.dataset.skyMinutes;
    const now = new Date();
    let night = isNight(preset !== undefined ? Number(preset) : now.getHours() * 60 + now.getMinutes());

    // Walks between the left edge and just before the Sky Dial (or the right edge).
    const measure = () => {
      const width = cat.offsetWidth;
      const dial = document.querySelector<HTMLElement>(".sky-dial");
      const limit = dial ? dial.getBoundingClientRect().left - DIAL_GAP_PX : innerWidth - EDGE_GAP_PX;
      bounds = { min: EDGE_GAP_PX, max: Math.max(EDGE_GAP_PX, limit - width) };
    };

    const render = () => {
      cat.style.transform = `translate3d(${Math.round(x)}px, 0, 0)`;
      cat.dataset.facing = facing === 1 ? "right" : "left";
    };

    const enter = (next: CatState) => {
      state = next;
      cat.dataset.pose = next;
      switch (next) {
        case "walk":
          timer = between(WALK_MS);
          break;
        case "sit":
          timer = between(SIT_MS);
          lookAt = Math.random() < 0.6 ? timer * (0.3 + Math.random() * 0.4) : -1;
          break;
        case "sleep":
          timer = Infinity;
          break;
        default: {
          const unhandled: never = next;
          throw new Error(`Unknown cat state: ${unhandled}`);
        }
      }
    };

    const tick = (dt: number) => {
      const offscreen = x < bounds.min;
      if (state === "walk") {
        x += facing * SPEED_PX_PER_S * (dt / 1000);
        if (x >= bounds.max) {
          x = bounds.max;
          facing = -1;
        } else if (x <= bounds.min && facing === -1) {
          x = bounds.min;
          facing = 1;
        }
      }
      timer -= dt;
      if (state === "sit" && lookAt >= 0 && timer <= lookAt) {
        facing = facing === 1 ? -1 : 1;
        lookAt = -1;
      }
      if (timer <= 0 && !offscreen) {
        if (state === "walk") {
          enter("sit");
        } else if (state === "sit") {
          if (x <= bounds.min) facing = 1;
          else if (x >= bounds.max) facing = -1;
          else facing = Math.random() < 0.5 ? 1 : -1;
          enter("walk");
        }
      }
      render();
    };

    let frame = 0;
    let last = 0;
    const loop = (time: number) => {
      tick(Math.min(time - last, MAX_FRAME_MS));
      last = time;
      frame = requestAnimationFrame(loop);
    };
    const start = () => {
      if (reduceMotion || frame) return;
      last = performance.now();
      frame = requestAnimationFrame(loop);
    };
    const stop = () => {
      cancelAnimationFrame(frame);
      frame = 0;
    };

    window.addEventListener(SKY_DIAL_EVENT, (event) => {
      night = isNight((event as CustomEvent<SkyDialChange>).detail.minutes);
      if (night && state !== "sleep") enter("sleep");
      else if (!night && state === "sleep") enter("sit");
    });

    document.addEventListener("visibilitychange", () => {
      cat.toggleAttribute("data-paused", document.hidden);
      if (document.hidden) stop();
      else start();
    });

    addEventListener("resize", () => {
      measure();
      x = Math.min(Math.max(x, bounds.min), bounds.max);
      render();
    });

    measure();
    if (night) {
      enter("sleep");
    } else if (reduceMotion) {
      enter("sit");
    } else {
      // Daytime entrance: trots in from beyond the left edge.
      x = -cat.offsetWidth;
      enter("walk");
    }
    render();
    start();
  }
</script>

<style>
  .cat-layer {
    position: fixed;
    left: 0;
    bottom: env(safe-area-inset-bottom);
    z-index: 35;
    pointer-events: none;
  }

  .cat {
    height: var(--cat-size);
    aspect-ratio: 32 / 24;
    transform: translateX(var(--space-2));
    will-change: transform;
  }

  .cat svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .cat[data-facing="left"] svg {
    transform: scaleX(-1);
  }

  .px-outline { fill: var(--cat-outline); }
  .px-fur-light { fill: var(--cat-fur-light); }
  .px-fur { fill: var(--cat-fur); }
  .px-fur-dark { fill: var(--cat-fur-dark); }
  .px-stripe { fill: var(--cat-stripe); }
  .px-cream { fill: var(--cat-cream); }
  .px-cream-shade { fill: var(--cat-cream-shade); }
  .px-eye { fill: var(--cat-eye); }
  .px-shine { fill: var(--cat-shine); }
  .px-nose { fill: var(--cat-nose); }
  .px-ear { fill: var(--cat-ear); }
  .px-blush { fill: var(--cat-blush); }
  .px-zzz { fill: var(--cat-zzz); }

  /*
    Frame-by-frame sprite animation: the first frame of the active pose is
    visible by default; the others flash in on a stepped opacity cycle.
  */
  .frame,
  .zzz {
    opacity: 0;
  }

  .cat[data-pose="sit"] .frame-sit-a,
  .cat[data-pose="walk"] .frame-walk-1,
  .cat[data-pose="sleep"] .frame-sleep-a {
    opacity: 1;
  }

  .cat[data-pose="sit"] .frame-sit-a {
    animation: frame-half 1.4s step-end infinite;
  }

  .cat[data-pose="sit"] .frame-sit-b {
    animation: frame-half 1.4s step-end -0.7s infinite;
  }

  .cat[data-pose="sit"] .frame-blink {
    animation: blink 4.6s step-end infinite;
  }

  .cat[data-pose="walk"] .frame-walk-1 {
    animation: frame-quarter 0.6s step-end infinite;
  }

  .cat[data-pose="walk"] .frame-walk-2 {
    animation: frame-quarter 0.6s step-end -0.45s infinite;
  }

  .cat[data-pose="walk"] .frame-walk-3 {
    animation: frame-quarter 0.6s step-end -0.3s infinite;
  }

  .cat[data-pose="walk"] .frame-walk-4 {
    animation: frame-quarter 0.6s step-end -0.15s infinite;
  }

  .cat[data-pose="sleep"] .frame-sleep-a {
    animation: frame-half 3.4s step-end infinite;
  }

  .cat[data-pose="sleep"] .frame-sleep-b {
    animation: frame-half 3.4s step-end -1.7s infinite;
  }

  .cat[data-pose="sleep"] .zzz {
    animation: z-rise 2.8s steps(5, end) infinite;
  }

  .cat[data-pose="sleep"] .zzz-small {
    animation-delay: -1.4s;
  }

  @keyframes frame-half {
    0% { opacity: 1; }
    50% { opacity: 0; }
  }

  @keyframes frame-quarter {
    0% { opacity: 1; }
    25% { opacity: 0; }
  }

  @keyframes blink {
    0% { opacity: 0; }
    93% { opacity: 1; }
    97% { opacity: 0; }
  }

  @keyframes z-rise {
    0% {
      opacity: 0;
      transform: translate(0, 2px);
    }
    20% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(2px, -5px);
    }
  }

  .cat[data-paused] * {
    animation-play-state: paused !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .cat * {
      animation: none !important;
    }

    .cat[data-pose="sleep"] .zzz-big {
      opacity: 1;
    }
  }
</style>

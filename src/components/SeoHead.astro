---
import type { CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";

interface Props {
  profile: CollectionEntry<"profile">["data"];
}

const { profile } = Astro.props;
const { seo } = profile;

const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;

const shareSource = seo.shareImage ?? profile.about.portrait;
const shareAlt = seo.shareImage ? seo.shareImageAlt : profile.about.portraitAlt;
const share = shareSource
  ? await getImage({ src: shareSource, width: 1200, height: 630, fit: "cover", format: "jpg" })
  : undefined;
const shareUrl = share ? new URL(share.src, site).href : undefined;

// Placeholder links like "https://www.instagram.com/" don't point at a real profile.
const profiles = profile.contact.socials
  .map((social) => social.url)
  .filter((url) => {
    try {
      return new URL(url).pathname.replace(/\/+$/, "") !== "";
    } catch {
      return false;
    }
  });

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site.href}#website`,
      url: site.href,
      name: seo.siteName,
      alternateName: seo.alternateNames,
      inLanguage: profile.language,
      publisher: { "@id": `${site.href}#person` },
    },
    {
      "@type": "Person",
      "@id": `${site.href}#person`,
      name: profile.name,
      url: site.href,
      jobTitle: seo.jobTitle,
      description: seo.description,
      email: `mailto:${profile.contact.email}`,
      ...(shareUrl ? { image: shareUrl } : {}),
      alumniOf: { "@type": "CollegeOrUniversity", name: seo.university },
      address: { "@type": "PostalAddress", addressLocality: seo.city, addressCountry: seo.country },
      knowsAbout: profile.skills,
      ...(profiles.length ? { sameAs: profiles } : {}),
    },
  ],
};

// Keeps "</script>" inside a string from ever closing the tag early.
const jsonLd = JSON.stringify(structuredData).replace(/</g, "\\u003c");
---

<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<meta name="author" content={profile.name} />
{seo.googleVerification && <meta name="google-site-verification" content={seo.googleVerification} />}

<meta property="og:type" content="profile" />
<meta property="og:site_name" content={seo.siteName} />
<meta property="og:locale" content={seo.locale} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
{shareUrl && <meta property="og:image" content={shareUrl} />}
{shareUrl && <meta property="og:image:width" content="1200" />}
{shareUrl && <meta property="og:image:height" content="630" />}
{shareUrl && shareAlt && <meta property="og:image:alt" content={shareAlt} />}

<meta name="twitter:card" content={shareUrl ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
{shareUrl && <meta name="twitter:image" content={shareUrl} />}

<script type="application/ld+json" set:html={jsonLd} />

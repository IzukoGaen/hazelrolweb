---
import { emphasis } from "../lib/emphasis";
import type { SectionProps } from "../lib/sections";

type Props = SectionProps;

const { profile, visible } = Astro.props;
const { hero } = profile;

const nameParts = profile.name.trim().split(/\s+/);
const lastName = nameParts.length > 1 ? nameParts.pop() : undefined;
const firstNames = nameParts.join(" ");
const year = new Date().getFullYear();
---

<section class="hero">
  <div class="container frame">
    <div class="grid-row hero-meta">
      <p class="cell label">{hero.eyebrow} — {year}</p>
      <p class="cell label tagline">{hero.tagline}</p>
      <div class="cell status-cell">
        <p class="sticker"><span class="dot" aria-hidden="true"></span>{hero.status}</p>
      </div>
    </div>

    <div class="hero-visual">
      <div class="cloud cloud-1" aria-hidden="true">
        <span class="cheek cheek-left"></span>
        <span class="cheek cheek-right"></span>
      </div>
      <div class="cloud cloud-2" aria-hidden="true"></div>
      <div class="cloud cloud-3" aria-hidden="true"></div>
      <h1 class="hero-name">
        {firstNames} {lastName && <em>{lastName}</em>}
      </h1>
    </div>

    <div class="grid-row hero-bottom">
      <div class="cell hero-intro">
        <ul class="swatches" aria-hidden="true">
          <li></li><li></li><li></li><li></li>
        </ul>
        <p class="small">{hero.intro}</p>
      </div>
      <div class="cell hero-statement">
        <p class="statement reveal" set:html={emphasis(hero.statement)} />
        {visible.has("work") && (
          <a class="label link-arrow" href="#work">
            {hero.scrollLabel} <span aria-hidden="true">↓</span>
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .hero-meta .tagline {
    display: none;
  }

  .status-cell {
    display: flex;
    align-items: center;
  }

  .sticker {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0.35rem 0.9rem;
    border: var(--border-thick) solid var(--outline);
    border-radius: var(--radius-pill);
    background: var(--surface);
    box-shadow: var(--shadow-hard-sm);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    transform: rotate(-2deg);
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--success);
    box-shadow: var(--shadow-status);
  }

  .hero-visual {
    position: relative;
    overflow: hidden;
    min-height: clamp(20rem, 58vh, 38rem);
    display: flex;
    align-items: flex-end;
    padding: clamp(var(--space-2), 2vw, var(--space-3));
    border-bottom: var(--border-thin) solid var(--line);
    background: linear-gradient(180deg, var(--hero-from) 0%, var(--hero-to) 100%);
  }

  .cloud {
    position: absolute;
    width: var(--w);
    height: calc(var(--w) * 0.32);
    border-radius: var(--radius-pill);
    background: var(--surface);
    animation: drift 16s ease-in-out infinite alternate;
  }

  .cloud::before,
  .cloud::after {
    content: "";
    position: absolute;
    border-radius: 50%;
    background: inherit;
  }

  .cloud::before {
    width: 46%;
    height: 145%;
    left: 14%;
    bottom: 30%;
  }

  .cloud::after {
    width: 36%;
    height: 115%;
    right: 14%;
    bottom: 38%;
  }

  .cloud-1 {
    --w: clamp(13rem, 34vw, 30rem);
    top: 16%;
    right: 6%;
  }

  .cloud-2 {
    --w: clamp(7rem, 18vw, 16rem);
    top: 10%;
    left: 8%;
    opacity: 0.85;
    animation-duration: 22s;
  }

  .cloud-3 {
    --w: clamp(9rem, 22vw, 20rem);
    bottom: 26%;
    right: 36%;
    opacity: 0.7;
    animation-duration: 19s;
    animation-direction: alternate-reverse;
  }

  .cheek {
    position: absolute;
    z-index: 1;
    top: 30%;
    width: 14%;
    height: 34%;
    border-radius: 50%;
    background: var(--highlight);
    opacity: 0.9;
  }

  .cheek-left {
    left: 24%;
  }

  .cheek-right {
    right: 24%;
  }

  @keyframes drift {
    to {
      transform: translate3d(-4%, 6%, 0);
    }
  }

  .hero-name {
    position: relative;
    font-size: var(--text-display);
    font-weight: 600;
    line-height: 0.85;
    letter-spacing: -0.055em;
    color: var(--ink);
  }

  .hero-intro {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .swatches {
    display: flex;
    gap: 0.375rem;
  }

  .swatches li {
    width: 3.25rem;
    aspect-ratio: 4 / 3;
    border: var(--border-thin) solid var(--outline);
  }

  .swatches li:nth-child(1) {
    background: var(--accent);
  }

  .swatches li:nth-child(2) {
    background: var(--highlight);
  }

  .swatches li:nth-child(3) {
    background: var(--accent-soft);
  }

  .swatches li:nth-child(4) {
    background: var(--ink);
  }

  .hero-statement {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    padding-block: clamp(var(--space-3), 4vw, 3.5rem);
  }

  .statement {
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.025em;
    max-width: 22ch;
  }

  @media (min-width: 720px) {
    .hero-meta .tagline {
      display: block;
    }

    .status-cell {
      justify-content: flex-end;
    }

    .hero-bottom {
      grid-template-columns: 1fr 2fr;
    }
  }
</style>
